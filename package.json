{
  "name": "noticons",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Noticons — 39,000+ offline icons inside Notion's own page-icon menu.",
  "license": "MIT",
  "homepage": "https://github.com/arhunsaday/notion-more-icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhunsaday/notion-more-icons.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "brand": "node scripts/brand.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "dev": "npm run build && node scripts/serve.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "verify": "npm run brand && npm test && npm run build"
  },
  "dependencies": {
    "@iconify-json/catppuccin": "1.2.17",
    "@iconify-json/circle-flags": "1.2.11",
    "@iconify-json/devicon": "1.2.64",
    "@iconify-json/duo-icons": "1.2.2",
    "@iconify-json/flat-color-icons": "1.2.3",
    "@iconify-json/fluent-color": "1.2.21",
    "@iconify-json/fluent-emoji-flat": "1.2.6",
    "@iconify-json/logos": "1.2.14",
    "@iconify-json/lucide": "1.2.133",
    "@iconify-json/material-icon-theme": "1.2.70",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/simple-icons": "1.2.96",
    "@iconify-json/skill-icons": "1.2.4",
    "@iconify-json/solar": "1.2.12",
    "@iconify-json/streamline-emojis": "1.2.4",
    "@iconify-json/streamline-ultimate-color": "1.2.2",
    "@iconify-json/tabler": "1.2.38",
    "@iconify-json/twemoji": "1.2.5",
    "@iconify/utils": "3.1.7",
    "fuse.js": "7.5.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "26.1.0"
  }
}
